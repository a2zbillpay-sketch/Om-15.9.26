# Client-side Supabase configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Optional Server-only Supabase Service Role Key (for secure backend write execution)
SUPABASE_SERVICE_ROLE_KEY=

# ADMIN_PASSWORD_HASH: Generated via node scrypt: "salt:derivedHexKey"
ADMIN_PASSWORD_HASH=
# Optional setup password (set in AI Studio Settings to securely generate ADMIN_PASSWORD_HASH without chat exposure)
ADMIN_SETUP_PASSWORD=
# ADMIN_SESSION_SECRET: Cryptographically random string (min 32 characters) for HMAC-SHA256 cookie signing
ADMIN_SESSION_SECRET=

# Administrator Recovery Configuration (Never commit real values)
# Registered recovery phone (e.g. 10-digit mobile number)
ADMIN_RECOVERY_PHONE=
# Registered recovery email
ADMIN_RECOVERY_EMAIL=
# Master Recovery Key (Emergency break-glass secret, min 16 characters)
ADMIN_RECOVERY_KEY=
# Optional external webhook or SMS gateway endpoint for OTP dispatch
ADMIN_OTP_SMS_PROVIDER_URL=

# Resend Email Delivery Configuration (for Admin Password Recovery OTP)
# Resend API Key from https://resend.com/api-keys
RESEND_API_KEY=
# Configured sender email address verified in Resend (e.g. "onboarding@resend.dev" for testing or "noreply@yourdomain.com")
RESEND_FROM_EMAIL=
