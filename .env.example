# Client-side Supabase configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Optional Server-only Supabase Service Role Key (for secure backend write execution)
# SUPABASE_SERVICE_ROLE_KEY=

# Optional Admin Credentials & Security (Stored persistently in Supabase; defaults & fallbacks provided)
# Optional initial bootstrap hash or setup password (persistently saved to Supabase on first run):
# ADMIN_PASSWORD_HASH=
# ADMIN_SETUP_PASSWORD=
# Required Server-only Session Secret for persistent HMAC session signing (min 32 characters, e.g. 64-char hex)
ADMIN_SESSION_SECRET=

# Administrator Recovery Configuration (Optional overrides; defaults configured in store)
# ADMIN_RECOVERY_PHONE=
# ADMIN_RECOVERY_EMAIL=
# Optional emergency break-glass secret (min 16 characters; standard flow uses 6-digit email OTP):
# ADMIN_RECOVERY_KEY=
# Optional external webhook or SMS gateway endpoint for OTP dispatch:
# ADMIN_OTP_SMS_PROVIDER_URL=

# Resend Email Delivery Configuration (for Admin Password Recovery OTP)
# Resend API Key from https://resend.com/api-keys
RESEND_API_KEY=
# Configured sender email address verified in Resend (e.g. "onboarding@resend.dev" for testing or "noreply@yourdomain.com")
RESEND_FROM_EMAIL=
